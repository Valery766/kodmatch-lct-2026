# This is a credential handoff contract, not a running application config.
# Fill only a private copy at .secrets/integrations.env.
# Values are deliberately empty until supplied; no existing project tokens.

PUBLIC_APP_URL=https://fsp.digital-projects.tech

# Confirmed service operator and support contact, required before real registration.
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_CONTACT=

# Email provider: use the provider's documented TLS configuration.
EMAIL_FROM=
EMAIL_REPLY_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS_MODE=starttls
SMTP_USERNAME=
SMTP_PASSWORD=

# Separate MAX bot: token is secret; moderation status supplied separately.
MAX_BOT_TOKEN=
MAX_BOT_USERNAME=

# Optional LLM: OpenAI-compatible base URL with /v1, exact model, key if required.
# The supplied local-LLM Compose overlay uses one call and a 35s deadline.
LLM_API_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_CONCURRENCY=2
LLM_PERSONAL_DATA_ALLOWED=false

# Official FSP API is not provided in the brief. Demo mode must be labelled.
FSP_PROVIDER_MODE=demo
